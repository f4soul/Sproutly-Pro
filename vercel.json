{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!api/|assets/|logos/|.*\\.(?:png|jpg|jpeg|gif|svg|ico|json|js|css|webmanifest|txt)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(index\\.html|sw\\.js|registerSW\\.js|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
