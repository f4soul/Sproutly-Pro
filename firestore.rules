rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}/data
    // Document ID: income
    // Fields:
    //   - years: array (required) - list of year data objects
    //   - taxBrackets: array (required) - list of tax bracket objects
    //   - activeYear: number (required) - currently selected year
    //   - updatedAt: string (optional) - ISO 8601 timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "filimlive@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidIncomeData(data) {
      return data.keys().hasAll(['years', 'taxBrackets', 'activeYear']) &&
             (data.years is map || data.years is list) &&
             (data.taxBrackets is map || data.taxBrackets is list) &&
             data.activeYear is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User data rules
    match /users/{userId}/data/income {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidIncomeData(request.resource.data);
      allow update: if isOwner(userId) && isValidIncomeData(request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Deposits rules
    match /deposits/{depositId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Cash Assets rules
    match /cashAssets/{cashAssetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Investment Assets rules
    match /investmentAssets/{assetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // User Settings rules
    match /userSettings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Tax Year Settings rules
    match /taxYearSettings/{settingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Banks rules
    match /banks/{bankId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // User profile rules (for role-based access)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Only admins can create/update roles, users can only create their basic profile
      allow create: if isOwner(userId) && 
                      (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isOwner(userId) && 
                      (request.resource.data.role == resource.data.role) || isAdmin();
    }
  }
}
