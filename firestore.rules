rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}/data
    // Document ID: income
    // Fields:
    //   - years: array (required) - list of year data objects
    //   - taxBrackets: array (required) - list of tax bracket objects
    //   - activeYear: number (required) - currently selected year
    //   - updatedAt: string (optional) - ISO 8601 timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidIncomeData(data) {
      return data.keys().hasAll(['years', 'taxBrackets', 'activeYear']) &&
             (data.years is map || data.years is list) &&
             (data.taxBrackets is map || data.taxBrackets is list) &&
             data.activeYear is number;
    }

    function isValidCashAsset(data) {
      return data.keys().hasAll(['userId', 'amount', 'currency', 'name']) &&
             data.userId is string &&
             data.amount is number &&
             data.currency is string &&
             data.name is string;
    }

    function isValidCryptoAsset(data) {
      return data.keys().hasAll(['userId', 'ticker', 'quantity', 'amount']) &&
             data.userId is string &&
             data.ticker is string &&
             data.quantity is number &&
             data.amount is number;
    }

    function isValidInvestmentAsset(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'amount', 'currentValue', 'currency']) &&
             data.userId is string &&
             data.name is string &&
             data.type is string &&
             data.amount is number &&
             data.currentValue is number &&
             data.currency is string;
    }

    function isValidDeposit(data) {
      return data.keys().hasAll(['userId', 'bank', 'amount', 'currency', 'rate', 'formula', 'isClosed']) &&
             data.userId is string &&
             data.bank is string &&
             data.amount is number &&
             data.currency is string &&
             data.rate is number &&
             data.formula is string &&
             data.isClosed is bool;
    }

    function isValidBank(data) {
      return data.keys().hasAll(['name', 'color', 'logoText', 'logoUrl']) &&
             data.name is string &&
             data.color is string &&
             data.logoText is string &&
             data.logoUrl is string;
    }

    function isValidTaxYearSettings(data) {
      return data.keys().hasAll(['userId', 'year', 'limit', 'ndflRate']) &&
             data.userId is string &&
             data.year is number &&
             data.limit is number &&
             data.ndflRate is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User data rules
    match /users/{userId}/data/income {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidIncomeData(request.resource.data);
      allow update: if isOwner(userId) && isValidIncomeData(request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Deposits rules
    match /deposits/{depositId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidDeposit(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidDeposit(request.resource.data);
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Cash Assets rules
    match /cashAssets/{cashAssetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidCashAsset(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidCashAsset(request.resource.data);
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Investment Assets rules
    match /investmentAssets/{assetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidInvestmentAsset(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidInvestmentAsset(request.resource.data);
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Crypto Assets rules
    match /cryptoAssets/{assetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidCryptoAsset(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidCryptoAsset(request.resource.data);
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // User Settings rules
    match /userSettings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Tax Year Settings rules
    match /taxYearSettings/{settingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidTaxYearSettings(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidTaxYearSettings(request.resource.data);
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Banks rules
    match /banks/{bankId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidBank(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidBank(request.resource.data);
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // User profile rules (for role-based access & FCM tokens)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
